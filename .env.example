# ═══════════════════════════════════════════════════════════════
# openvibe.network — Environment Configuration
# Copy to .env and fill in values. No secrets belong in this file.
# Production env lives at /etc/openvibe/network.env (mode 0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:4000
OV_NETWORK_URL=http://localhost:4000
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_NETWORK_LOGIN_URL=http://localhost:4000

# Security — CHANGE THESE IN PRODUCTION
# Internal API key shared with OpenVibe.Live, OpenVibe.Tools, OpenVibe.Games,
# and OpenVibe.Media for /internal/* calls (header X-Internal-Key)
INTERNAL_API_KEY=change-me-to-a-random-64-char-string
SETUP_TOKEN=change-me-to-a-second-random-secret
BOOTSTRAP_PROFILE=local-dev

# Developer projects (docs/developer-projects.md)
# Audiences that accept sandbox app tokens, comma-separated. Leave it UNSET for the code default
# (openvibe.media,openvibe.events,openvibe.tools); set it to an empty value to accept none.
# DEV_SANDBOX_AUDIENCES=openvibe.media,openvibe.events,openvibe.tools
# Public capabilities every project's SANDBOX apps may hold without staff, comma-separated. Leave it
# UNSET for the code default (media.object.upload/read, events.app.publish/read/subscribe,
# tools.job.create/read/cancel; ids the installed contracts do not define are skipped); empty = none.
# Production apps only ever use the staff-set project allowance.
# DEV_SANDBOX_ALLOWANCE=media.object.upload,media.object.read,events.app.publish,events.app.read,events.app.subscribe,tools.job.create,tools.job.read,tools.job.cancel
# Seconds a rotated client secret keeps working (0..604800; default 86400)
DEV_CREDENTIAL_OVERLAP_S=86400
# Public capabilities every new project's allowance starts with, comma-separated. Empty = staff grant each one.
DEV_DEFAULT_ALLOWANCE=
DEV_MAX_PROJECTS_PER_OWNER=10
DEV_MAX_APPS_PER_PROJECT=20
# OpenVibe.Events base URL for relaying developer-project events (network.app.*, network.credential.*,
# network.grant.changed). Unset = no relay (events stay in dev_audit and are backfilled once it is set).
# OV_EVENTS_INTERNAL_URL=http://127.0.0.1:4300

# Admin account auto-created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Owner account (gates owner-only admin areas: Deploy, SSH, secrets)
OWNER_USERNAME=

# Paths (relative to project root)
DB_PATH=./data/network.db
AVATAR_PATH=data/avatars
JWT_PRIVATE_KEY=data/keys/private.pem
JWT_PUBLIC_KEY=data/keys/public.pem

# Public service URLs (defaults shown; override for local dev / white-label)
#OV_LIVE_URL=https://openvibe.live
#OV_TOOLS_URL=https://openvibe.tools
#OV_GAMES_URL=https://openvibe.games
#OV_MEDIA_URL=https://openvibe.media

# Connected services (internal, not proxied through Cloudflare)
OV_LIVE_INTERNAL_URL=http://127.0.0.1:3000
OV_TOOLS_INTERNAL_URL=http://127.0.0.1:4001
OV_GAMES_INTERNAL_URL=http://127.0.0.1:8000
OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100

# Optional: SSH admin-tab context (non-secret display values)
#SSH_SERVER_HOST=
#SSH_PROJECTS_ROOT=/opt/openvibe.network /opt/openvibe.live

# ═══════════════════════════════════════════════════════════════
# Provider secrets (server/secrets.js). Each one is read from its variable first; the admin
# panel's database copy is only a fallback, and the panel cannot change one set here. In
# production put them in /etc/openvibe/network.env; scripts/secrets-out-of-db.js then blanks
# the database copies (README "Provider secrets").
# ═══════════════════════════════════════════════════════════════
#RESEND_API_KEY=
#RESEND_WEBHOOK_SECRET=
#DISCORD_BOT_TOKEN=
#DISCORD_OAUTH_CLIENT_SECRET=
#VAPID_PRIVATE_KEY=
#VAPID_PUBLIC_KEY=   (optional: derived from VAPID_PRIVATE_KEY)

# ═══════════════════════════════════════════════════════════════
# Email Notifications (optional)
#
# From-addresses are managed through the admin panel; the Resend API key is RESEND_API_KEY
# above (or, as a fallback, the admin panel).
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# Notifications
# ═══════════════════════════════════════════════════════════════
# Enable/disable the notification system globally
NOTIFICATIONS_ENABLED=true
# Days to keep old notifications before cleanup (default: 30)
NOTIFICATION_MAX_AGE_DAYS=30
# Only send emails for CRITICAL priority notifications (recommended)
NOTIFICATION_EMAIL_CRITICAL_ONLY=true

# ═══════════════════════════════════════════════════════════════
# RSA Key Generation (run once during setup):
#
#   mkdir -p data/keys
#   openssl genrsa -out data/keys/private.pem 2048
#   openssl rsa -in data/keys/private.pem -pubout -out data/keys/public.pem
#
# The private key stays on openvibe.network only. Other services verify
# tokens OFFLINE via the JWKS endpoint (/api/.well-known/jwks).
# ═══════════════════════════════════════════════════════════════
