 package-lock.json               |   7 +-
 package.json                    |   2 +-
 server/index.js                 |  56 +++++-----
 server/web/observability.js     | 108 ++++++++++++++++++++
 test/observability.test.js      | 175 ++++++++++++++++++++++++++++++++
 7 files changed, 323 insertions(+), 34 deletions(-)
