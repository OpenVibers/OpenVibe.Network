      "ports": {
        "http": 3000,
        "rtmp": [
          1935,
          9935
        ],
        "mediasoup": "11000-11300/udp",
        "jsmpegRelayTls": "9710-9789"
      },
      "runtime": "Node/Express (socket-activated), SQLite, mediasoup/werift/Node-Media-Server/ffmpeg",
      "units": [
        "openvibe-live.socket",
        "openvibe-live.service"
      ],
      "deployPath": "/opt/openvibe.live",
      "envFile": "/etc/openvibe/live.env",
      "databases": [
        "data/live.db",
        "data/analytics.db",
        "data/rs-companion.db"
      ],
      "owns": "streaming product: channels, presentation, WHIP/WebRTC/JSMPEG ingest and RTMP for every slot (OpenRe holds none yet), restream, calls, Vibes/PayPal and subscriptions (Billing is a shadow), arena, recap; chat, pastes, comments and AI runs moved to Chat, Community and AI (Live keeps mirrors and adapters)"
    },
    {
