{
  "_source": "Hand-maintained from ../../../../CONTRACTS.md (workspace root) and the production unit list. generate.js checks units/paths against prod-snapshot.json and flags drift. Services added 2026-09-23 from the production unit list and the roadmap port plan. `databases` are the files each service actually opens (absolute, or relative to deployPath; <app> matches one path segment): any other SQLite file found on the host is reported as a copy or an undeclared file, not as live schema.",
  "services": [
    {
      "id": "network",
      "repo": "OpenVibe.Network",
      "stage": "live",
      "domains": [
        "openvibe.network",
        "auth.openvibe.network",
        "api.openvibe.network",
        "admin.openvibe.network",
        "my.openvibe.network",
        "themes.openvibe.network"
      ],
      "ports": {
        "http": 4000
      },
      "runtime": "Node/Express, SQLite (better-sqlite3)",
      "units": [
        "openvibe-network.service"
      ],
      "deployPath": "/opt/openvibe.network",
      "envFile": "/etc/openvibe/network.env",
      "databases": [
        "data/network.db"
      ],
      "owns": "identity/OAuth2/OIDC/FedCM, anonymous sessions, themes, notifications + push/email, OpenCoins wallet, url registry + domains, chrome, avatars, admin, serves openvibe-shared browser files at /shared/"
    },
    {
      "id": "live",
      "repo": "OpenVibe.Live",
      "stage": "live",
